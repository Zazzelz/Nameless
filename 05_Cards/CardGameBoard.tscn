[sub_resource type="GDScript" id="GDScript_5qeed"]
resource_name = "CardGameBoardManager"
script/source = "extends Node

@onready var player_deck_manager = $PlayerDeckManager
@onready var player_deck_zone = $PlayerDeckManager/PlayerDeckZone
@onready var opponent_deck_manager = $OpponentDeckManager
@onready var opponent_deck_zone = $OpponentDeckManager/OpponentDeckZone
@onready var player_hand_zone = $PlayerDeckManager/PlayerHandZone

var card_index := 0

func _ready():
	for i in range(4):
		deal_card_to_playerDeck()
		deal_card_to_opponentDeck()

func deal_card_to_playerDeck():
	var card_data = player_deck_manager.draw_card()
	if card_data:
		var card = preload(\"res://05_Cards/3DCard.tscn\").instantiate()
		card.name = \"3DCard\" + str(card_index)
		card_index += 1
		card.set_card_data(card_data)
		player_deck_zone.add_child(card)
		var index = player_deck_zone.get_child_count() - 1
		spawn_card(card, player_deck_zone, index)

func deal_card_to_opponentDeck():
	var card_data = opponent_deck_manager.draw_card()
	if card_data:
		var card = preload(\"res://05_Cards/3DCard.tscn\").instantiate()
		card.name = \"3DCard\" + str(card_index)
		card_index += 1
		card.set_card_data(card_data)
		opponent_deck_zone.add_child(card)
		var index = opponent_deck_zone.get_child_count() - 1
		spawn_card(card, opponent_deck_zone, index)
		card.set_meta(\"deck_transform\", card.global_transform)

func spawn_card(card: Node3D, target_zone: Node3D, index: int):
	print(\"Spawning card in zone:\", target_zone.name)
	var mesh = target_zone.get_node_or_null(\"ZoneMesh\")
	if mesh == null:
		print(\"Mesh not found in\", target_zone.name)
		return

	var mesh_size = mesh.get_aabb().size
	var card_pos: Vector3

	if target_zone.name == \"PlayerDeckZone\":
		var base_pos = mesh.transform.origin
		var stack_offset = Vector3(0, index * 0.01, 0)
		card_pos = base_pos + stack_offset

		var card_mesh = card.get_node_or_null(\"CardMesh\")
		if card_mesh != null:
			var card_size = card_mesh.get_aabb().size
			var scale_x = mesh_size.x / card_size.x
			var scale_z = mesh_size.z / card_size.z
			var scale_y = 3.0
			var final_scale = Vector3(scale_x, scale_y, scale_z)
			card.scale = final_scale
			card.set_meta(\"final_scale\", final_scale)
		else:
			print(\"Card mesh not found in\", card.name)

		card.rotation_degrees = Vector3(90, 180, 180)
		card.position = card_pos
		card.base_position = Vector3(card.position.x, -0.123, card.position.z)

	elif target_zone.name == \"PlayerHandZone\":
		var spacing = -0.4
		var card_index = 0
		for child in target_zone.get_children():
			if child.get_class() == \"Node3D\" and child.has_method(\"set_card_data\") and child.name != \"ZoneMesh\":
				card_index += 1
		card_index = max(0, card_index - 1)

		var anchor = target_zone.get_node_or_null(\"ZoneMesh\")
		var anchor_global_pos = anchor.global_transform.origin if anchor else target_zone.global_transform.origin

		var z_offset = 1.0  # Shift cards to the right on the Z-axis
		var card_global_pos = anchor_global_pos + Vector3(0, -0.123, card_index * spacing + z_offset)

		card.set_as_top_level(true)
		card.global_transform.origin = card_global_pos

		card.scale = Vector3(0.3, 0.5, 0.5)  # Narrow X-axis scale
		card.rotation_degrees = Vector3(0, 90, 0)

		var card_mesh = card.get_node_or_null(\"FrontFace\")
		if card_mesh == null:
			print(\"FrontFace not found in\", card.name)
		if card_mesh:
			card_mesh.scale = Vector3.ONE
			card_mesh.rotation_degrees = Vector3.ZERO

		card.base_position = Vector3(card.position.x, card.position.y, card.position.z)
	elif target_zone.name == \"OpponentDeckZone\":
		var base_pos = mesh.transform.origin
		var stack_offset = Vector3(0, index * 0.01, 0)
		card.position = base_pos + stack_offset

		card.rotation_degrees = Vector3(90, 0, 0)
		card.scale = Vector3(0.3, 3.0, 0.3)
		card.base_position = Vector3(card.position.x, card.position.y, card.position.z)
	else:
		print(\"Unknown target zone:\", target_zone.name)
		return

	if not card.is_connected(\"card_clicked\", Callable(self, \"_on_card_clicked\")):
		card.connect(\"card_clicked\", Callable(self, \"_on_card_clicked\"))

func _on_card_clicked(card: Node3D):
	print(\"Card clicked signal received:\", card.name)

	var deck_cards = []
	for child in player_deck_zone.get_children():
		if child.get_class() == \"Node3D\" and child.has_method(\"set_card_data\"):
			deck_cards.append(child)

	if deck_cards.size() == 0:
		return

	var top_card = deck_cards[-1]
	if top_card.name == card.name:
		var cards_to_move: Array = deck_cards.slice(0, min(4, deck_cards.size()))
		for moved_card in cards_to_move:
			player_deck_zone.remove_child(moved_card)
			player_hand_zone.add_child(moved_card)
			print(\"Moving card to hand:\", moved_card.name)
			print(\"Hand zone valid:\", player_hand_zone != null)
			var index = player_hand_zone.get_child_count() - 1
			spawn_card(moved_card, player_hand_zone, index)
	else:
		print(\"Clicked card is not the top card:\", card.name)
"

